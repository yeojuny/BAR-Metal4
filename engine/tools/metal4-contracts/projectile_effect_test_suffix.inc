float Field(const rendering::NativeProjectileEffectDraw& d,unsigned n){float f;memcpy(&f,d.instances->bytes.data()+4*n,4);return f;}
void Close(float a,float b,const char* name){CheckTest(std::abs(a-b)<.0001f,name);}
void Dump(const rendering::NativeProjectileEffectFrame& frame,const std::string& path){std::ofstream out(path);out<<"{\"draws\":[";bool first=true;for(const auto& d:frame.draws){if(!first)out<<',';first=false;out<<"{\"program\":"<<unsigned(d.program)<<",\"instances\":"<<d.instanceCount<<",\"stride\":"<<d.instances->layout.stride<<",\"sequence\":"<<d.sequence<<",\"texture\":\""<<(d.texture?d.texture->sourceName:"")<<"\",\"parameters\":{";bool p=true;for(auto&[name,value]:d.parameters){if(!p)out<<',';p=false;out<<'"'<<name<<"\":"<<value;}out<<"},\"data\":[";for(unsigned n=0;n<d.instanceCount*d.instances->layout.stride/4;++n){if(n)out<<',';out<<Field(d,n);}out<<"]}";}out<<"]}\n";}
