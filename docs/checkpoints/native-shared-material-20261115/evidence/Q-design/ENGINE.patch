+		return nil
+	end
+	vertexVBO:Define(3, { { id = 0, name = "unused", size = 1 } })
+	vertexVBO:Upload({ 0, 0, 0 })
+	indexVBO:Define(3)
+	indexVBO:Upload({ 0, 1, 2 })
+	instanceVBO:Define(1, { { id = 1, name = "unusedInstance", size = 1 } })
+	instanceVBO:Upload({ 0 })
