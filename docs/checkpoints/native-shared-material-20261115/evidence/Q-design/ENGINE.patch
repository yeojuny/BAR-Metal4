+	return true
+end
+
+function widget:Initialize()
+	if gl.CreateShader == nil then
+		spEcho("Sepia: createshader not supported, removing")
+		widgetHandler:RemoveWidget()
+		return
+	end
+
+	sepiaShader = LuaShader({
+		vertex = vsSepia,
+		fragment = fsSepia,
