+		local row, s = {}, SEPIA[i]
+		for j = 1, 3 do
+			local toned = s[1] * cs[1][j] + s[2] * cs[2][j] + s[3] * cs[3][j]
+			row[j] = cs[i][j] + (toned - cs[i][j]) * sepia
+		end
+		sepiaShader:SetUniform(COLOR_ROWS[i], row[1], row[2], row[3])
+	end
+end
