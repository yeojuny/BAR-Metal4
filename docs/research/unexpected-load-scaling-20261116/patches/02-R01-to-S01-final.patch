+template<class Draws,class Classify>
+size_t GrassSuffixS01(const Draws& draws,Classify classify) noexcept {
+ size_t first=NoGrassBoundaryS01;
+ for(size_t n=0;n<draws.size();++n){
+  const auto kind=classify(draws[n]);
