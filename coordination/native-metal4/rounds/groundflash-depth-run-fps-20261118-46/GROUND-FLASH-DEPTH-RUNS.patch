+
+bool CoalesceLastGroundFlashRanges(NativeWorldParticleFrame& frame)
+{
+	if (frame.ranges.size() < 2)
+		return false;
+
+	auto& previous = frame.ranges[frame.ranges.size() - 2];
+	const auto& next = frame.ranges.back();
+	if (previous.stage != NativeWorldParticleStage::GroundFlashes ||
+		next.stage != NativeWorldParticleStage::GroundFlashes ||
+		!previous.groundAtlas || !next.groundAtlas ||
+		previous.depthTest != next.depthTest || previous.depthWrite != next.depthWrite ||
+		std::bit_cast<std::uint32_t>(previous.alphaThreshold) != std::bit_cast<std::uint32_t>(next.alphaThreshold) ||
+		std::bit_cast<std::uint32_t>(previous.softenThreshold) != std::bit_cast<std::uint32_t>(next.softenThreshold))
+		return false;
+
+	const std::uint64_t previousEnd = std::uint64_t(previous.firstIndex) + previous.indexCount;
+	const std::uint64_t nextEnd = std::uint64_t(next.firstIndex) + next.indexCount;
+	if (!previous.indexCount || !next.indexCount || previous.indexCount % 3 || next.indexCount % 3 ||
+		previousEnd != next.firstIndex || nextEnd != frame.indices.size() ||
+		nextEnd > std::numeric_limits<std::uint32_t>::max())
+		return false;
+
+	// Geometry, triangle order, and per-flash validation have already been published.
+	previous.indexCount = static_cast<std::uint32_t>(nextEnd - previous.firstIndex);
+	frame.ranges.pop_back();
+	++frame.collapsedGroundFlashRanges;
+	return true;
 }
+}
