+struct BloomPrepareDefinitions {
+ struct Entry { unsigned depthMask=0; bool combine=false; std::string text; };
+ const NativeBloomDefines* previous=nullptr;
+ std::locale locale;
+ std::array<Entry,4> variants;
+ std::size_t used=0;
