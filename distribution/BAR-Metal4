  export BAR_NATIVE_CAP2_PRESENT_AFTER_SUBMIT=0
  export BAR_NATIVE_CAP2_PRESENT_BEFORE_NEXT_ACQUIRE=0
fi

# Diagnostic collection is an explicit launch option and is off by default.
case "${BAR_METAL4_DIAGNOSTICS:-off}" in
  off) ;;
  critical-path)
    export BAR_NATIVE_FRAME_TRACE=1
    export BAR_NATIVE_FRAME_TRACE_EVERY_LOOP=1
    export BAR_NATIVE_FRAME_TRACE_START_SIM=300
    export BAR_NATIVE_FRAME_TRACE_END_SIM=306
    ;;
  *) echo "BAR_METAL4_DIAGNOSTICS must be off or critical-path" >&2; exit 2 ;;
esac
case "${BAR_METAL4_METAL_VALIDATION:-0}" in
  0) ;;
  1) export MTL_DEBUG_LAYER=1 ;;
  *) echo "BAR_METAL4_METAL_VALIDATION must be 0 or 1" >&2; exit 2 ;;
esac
