#!/bin/sh
set -eu
resources="$(CDPATH= cd -- "$(dirname -- "$0")/../Resources" && pwd)"
state="${BAR_METAL4_STATE_DIRECTORY:-$HOME/Library/Application Support/BAR-Metal4}"
export BAR_STATE_PATH="$state"
export BAR_ASSETS_PATH="$state/assets"
export BAR_METAL4_EXPERIMENTAL_SINGLEPLAYER=1
export MTL_DEBUG_LAYER=0
export MTL_SHADER_VALIDATION=0
export MTL_SHADER_VALIDATION_ENABLE_ERROR_REPORTING=0
export BAR_NATIVE_MODEL_TRACE=0
export BAR_NATIVE_SUBMISSION_TRACE=0
export BAR_NATIVE_FRAME_TRACE=0
export BAR_METAL4_EXPERIMENTAL_SINGLEPLAYER='1'
export MTL_DEBUG_LAYER='0'
export MTL_SHADER_VALIDATION='0'
export MTL_SHADER_VALIDATION_ENABLE_ERROR_REPORTING='0'
export BAR_NATIVE_MODEL_TRACE='0'
export BAR_NATIVE_SUBMISSION_TRACE='0'
export BAR_NATIVE_FRAME_TRACE='0'
export BAR_NATIVE_MEMORY_CENSUS='0'
export BAR_NATIVE_COMPILER_MEMORY='0'
export BAR_NATIVE_HEAP_COLLECT='0'
export BAR_NATIVE_HEAP_STATS='0'
export BAR_NATIVE_LARGE_HEAP='0'
export BAR_NATIVE_PREPARATION_TRACE='0'
export BAR_NATIVE_HOST_COST_TRACE='0'
export BAR_NATIVE_VBO_COPY_TRACE='0'
export BAR_NATIVE_PUBLICATION_TRACE='0'
export BAR_NATIVE_FINAL_COLOR_STAGE='1'
export BAR_NATIVE_FRAME_OVERLAP='1'
export BAR_NATIVE_FRAME_OVERLAP_PROBE_FILE=''
export BAR_NATIVE_CAPTURE_OVERLAP='1'
export BAR_NATIVE_RESOURCE_PROBE_FILE=''
export BAR_NATIVE_PROFILER_SOURCE_PROBE_FILE=''
export BAR_NATIVE_COMMON_LINE_PROBE_FILE=''
export BAR_NATIVE_PREPARE_OVERLAP='1'
export BAR_NATIVE_WORLD_INFO_STORAGE_PROBE_FILE=''
export BAR_NATIVE_PASS_COST136_FILE=''
export BAR_NATIVE_PASS160='1'
export BAR_NATIVE_PASS165='1'
export BAR_NATIVE_PASS166='1'
export BAR_NATIVE_RECORD158='1'
export BAR_NATIVE_RETAINED_FONT170='1'
mkdir -p "$BAR_ASSETS_PATH/maps" "$state/data"
content="${BAR_METAL4_CONTENT_DIRECTORY:-/opt/homebrew/opt/bar-metal4-content/share/bar-metal4-content}"
if [ ! -f "$content/packages/7a0e6ff2ee6f899654edd8cc997b5386.sdp" ]; then
  /usr/bin/osascript -e 'display alert "BAR Metal4 game data is missing" message "Install with Homebrew: brew install --cask yeojuny/bar-metal4/bar-metal4"' >/dev/null 2>&1 || true
  exit 1
fi
if [ ! -f "$BAR_ASSETS_PATH/.content-2026.10.23-ready" ] || [ ! -f "$BAR_ASSETS_PATH/packages/7a0e6ff2ee6f899654edd8cc997b5386.sdp" ] || [ ! -d "$BAR_ASSETS_PATH/pool" ]; then
  /usr/bin/ditto "$content" "$BAR_ASSETS_PATH"
  : > "$BAR_ASSETS_PATH/.content-2026.10.23-ready"
fi
cd "$resources/BAR.app/Contents/MacOS"
exec ./BAR --config "$resources/lobby-config.json" "$@"
